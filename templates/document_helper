<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doc Analyser — know what you're signing</title>
    <style>
        @font-face {
            font-family: 'CohereText';
            src: local('Space Grotesk');
        }

        :root {
            --primary: #17171c;
            --ink: #212121;
            --deep-green: #003c33;
            --canvas: #ffffff;
            --soft-stone: #eeece7;
            --pale-green: #edfce9;
            --hairline: #d9d9dd;
            --border-light: #e5e7eb;
            --muted: #93939f;
            --slate: #75758a;
            --body-muted: #616161;
            --action-blue: #1863dc;
            --coral: #ff7759;
            --coral-soft: #ffad9b;
            --form-focus: #9b60aa;
            --on-dark: #ffffff;
            --error: #b30000;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--canvas);
            color: var(--ink);
            font-family: 'Unica77 Cohere Web', 'Inter', ui-sans-serif, system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .display {
            font-family: 'CohereText', 'Space Grotesk', 'Inter', ui-sans-serif, sans-serif;
        }

        .mono {
            font-family: 'CohereMono', 'Space Mono', monospace;
            letter-spacing: 0.28px;
        }

        .bar {
            background: #000;
            color: var(--on-dark);
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            letter-spacing: 0.28px;
        }

        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 24px 48px;
            border-bottom: 1px solid var(--border-light);
        }

        .word {
            font-size: 18px;
            font-weight: 500;
            letter-spacing: -0.2px;
        }

        .word span {
            color: var(--coral);
        }

        nav .links {
            display: flex;
            gap: 32px;
            font-size: 14px;
            color: var(--slate);
        }

        .hero {
            padding: 96px 48px 64px;
            text-align: center;
            max-width: 820px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 64px;
            line-height: 1.02;
            letter-spacing: -1.4px;
            font-weight: 400;
            margin: 0 0 20px;
        }

        .hero p {
            font-size: 18px;
            line-height: 1.4;
            color: var(--body-muted);
            max-width: 560px;
            margin: 0 auto;
        }

        .workspace {
            background: var(--soft-stone);
            padding: 64px 24px 96px;
        }

        .card {
            max-width: 720px;
            margin: 0 auto;
            background: var(--canvas);
            border-radius: 22px;
            padding: 40px;
            border: 1px solid var(--card-border, #f2f2f2);
        }

        .mono-label {
            font-family: 'CohereMono', 'Space Mono', monospace;
            font-size: 14px;
            letter-spacing: 0.28px;
            color: var(--slate);
            text-transform: uppercase;
            margin: 0 0 16px;
        }

        textarea {
            width: 100%;
            min-height: 180px;
            resize: vertical;
            border: 1px solid var(--hairline);
            border-radius: 8px;
            padding: 16px;
            font-size: 15px;
            line-height: 1.5;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: var(--canvas);
        }

        textarea:focus {
            border-color: var(--form-focus);
            box-shadow: 0 0 0 3px rgba(155, 96, 170, 0.15);
        }

        .dropzone {
            margin-top: 16px;
            border: 1px dashed var(--hairline);
            border-radius: 8px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
            color: var(--slate);
            background: var(--pale-green);
        }

        .dropzone.drag {
            border-color: var(--form-focus);
            background: #f6eef8;
        }

        .dropzone label {
            cursor: pointer;
            color: var(--action-blue);
            text-decoration: underline;
            font-weight: 500;
        }

        input[type=file] {
            display: none;
        }

        .file-chip {
            display: none;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            font-size: 13px;
            color: var(--ink);
            background: var(--soft-stone);
            border-radius: 32px;
            padding: 6px 14px;
            width: fit-content;
        }

        .file-chip button {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--slate);
            font-size: 14px;
            padding: 0;
        }

        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 24px;
        }

        .disclaimer {
            font-size: 12px;
            color: var(--muted);
            max-width: 280px;
            line-height: 1.4;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--on-dark);
            border: none;
            border-radius: 32px;
            padding: 12px 28px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            letter-spacing: 0;
            transition: opacity 0.15s;
        }

        .btn-primary:hover {
            opacity: 0.85;
        }

        .btn-primary:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .error-text {
            color: var(--error);
            font-size: 13px;
            margin-top: 8px;
            display: none;
        }

        .result-wrap {
            max-width: 720px;
            margin: 32px auto 0;
            display: none;
        }

        .console {
            background: var(--primary);
            color: var(--on-dark);
            border-radius: 8px;
            padding: 32px;
        }

        .console .mono-label {
            color: var(--coral-soft);
        }

        .doctype {
            font-size: 28px;
            font-weight: 400;
            letter-spacing: -0.3px;
            margin: 0 0 16px;
        }

        .desc {
            font-size: 16px;
            line-height: 1.6;
            color: #e7e7ea;
            margin: 0 0 24px;
        }

        .points {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .point {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 30px;
            padding: 6px 14px;
            font-size: 13px;
            color: #e7e7ea;
        }

        .loading {
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--slate);
            margin-top: 16px;
        }

        .spinner {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid var(--hairline);
            border-top-color: var(--primary);
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        footer {
            background: var(--primary);
            color: var(--on-dark);
            padding: 32px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--muted);
        }

        @media (max-width:640px) {
            nav {
                padding: 20px 24px;
            }

            nav .links {
                display: none;
            }

            .hero {
                padding: 56px 24px 40px;
            }

            .hero h1 {
                font-size: 38px;
                letter-spacing: -0.8px;
            }

            .card {
                padding: 24px;
            }

            .row {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            footer {
                flex-direction: column;
                gap: 8px;
                text-align: center;
            }
        }
    </style>
</head>

<body>

 

    <div class="hero">
        <h1 class="display">Know what you're signing<br>before you sign it.</h1>
        <p>Paste or drop a contract, notice, or agreement. Get a short, plain-language description of what it actually
            is — no jargon, no legal opinion.</p>
    </div>

    <div class="workspace">
        <div class="card">
            <p class="mono-label">01 — Paste or upload</p>
            <textarea id="docText" placeholder="Paste the text of your document here..."></textarea>
            <div class="dropzone" id="dropzone">
                <span>or drop a .txt file, or <label for="fileInput">browse</label></span>
                <input type="file" id="fileInput">
            </div>
            <div class="file-chip" id="fileChip">
                <span id="fileName"></span>
                <button id="clearFile" aria-label="Remove file">✕</button>
            </div>

            <div class="row">
                <p class="disclaimer">This gives a short description only — not legal advice. For anything binding, talk
                    to a lawyer.</p>
                <button class="btn-primary" id="analyseBtn">Analyse document</button>
            </div>
            <div class="error-text" id="errorText">Paste some text or upload a file first.</div>
            <div class="loading" id="loadingRow">
                <div class="spinner"></div>Reading the document...
            </div>
        </div>

        <div class="result-wrap" id="resultWrap">
            <div class="console">
                <p class="mono-label">Document type</p>
                <p class="doctype" id="outType">—</p>
                <p class="desc" id="outDesc">—</p>
                <div class="points" id="outPoints"></div>
            </div>
        </div>
    </div>

    <script>
        const docText = document.getElementById('docText');
        const fileInput = document.getElementById('fileInput');
        const dropzone = document.getElementById('dropzone');
        const fileChip = document.getElementById('fileChip');
        const fileName = document.getElementById('fileName');
        const clearFile = document.getElementById('clearFile');
        const analyseBtn = document.getElementById('analyseBtn');
        const errorText = document.getElementById('errorText');
        const loadingRow = document.getElementById('loadingRow');
        const resultWrap = document.getElementById('resultWrap');
        const outType = document.getElementById('outType');
        const outDesc = document.getElementById('outDesc');
        const outPoints = document.getElementById('outPoints');

        function readFile(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                docText.value = e.target.result;
                fileName.textContent = file.name;
                fileChip.style.display = 'flex';
            };
            reader.readAsText(file);
        }

        fileInput.addEventListener('change', e => readFile(e.target.files[0]));
        clearFile.addEventListener('click', () => {
            fileInput.value = '';
            fileChip.style.display = 'none';
        });

        ['dragover', 'dragenter'].forEach(ev => dropzone.addEventListener(ev, e => {
            e.preventDefault(); dropzone.classList.add('drag');
        }));
        ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, e => {
            e.preventDefault(); dropzone.classList.remove('drag');
        }));
        dropzone.addEventListener('drop', e => {
            const file = e.dataTransfer.files[0];
            if (file) readFile(file);
        });

        analyseBtn.addEventListener('click', async () => {
            const text = docText.value.trim();
            errorText.style.display = 'none';
            if (!text) {
                errorText.style.display = 'block';
                return;
            }

            analyseBtn.disabled = true;
            loadingRow.style.display = 'flex';
            resultWrap.style.display = 'none';

            try {
                const response = await fetch("https://api.anthropic.com/v1/messages", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: "claude-sonnet-4-6",
                        max_tokens: 1000,
                        messages: [{
                            role: "user",
                            content: "You are a legal document analyser. Given the document text below, respond ONLY with JSON, no preamble, no markdown fences, in this exact shape: " +
                                '{"type": "short document type name, e.g. Rental Agreement", "description": "2-3 plain-language sentences describing what this document is and its main purpose, no legal advice or opinions", "points": ["3-5 short factual labels, 2-5 words each, naming the key elements present, e.g. Fixed 11-month term"]}' +
                                "\\n\\nDocument text:\\n" + text.slice(0, 15000)
                        }]
                    })
                });
                const data = await response.json();
                const raw = data.content.map(b => b.text || "").join("").trim();
                const clean = raw.replace(/^```json|```$/g, "").trim();
                const parsed = JSON.parse(clean);

                outType.textContent = parsed.type || "Unclassified document";
                outDesc.textContent = parsed.description || "";
                outPoints.innerHTML = "";
                (parsed.points || []).forEach(p => {
                    const el = document.createElement('div');
                    el.className = 'point';
                    el.textContent = p;
                    outPoints.appendChild(el);
                });
                resultWrap.style.display = 'block';
                resultWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } catch (err) {
                outType.textContent = "Couldn't read this one";
                outDesc.textContent = "Something went wrong parsing the document. Try shortening the text or check the formatting and try again.";
                outPoints.innerHTML = "";
                resultWrap.style.display = 'block';
            } finally {
                analyseBtn.disabled = false;
                loadingRow.style.display = 'none';
            }
        });
    </script>

</body>

</html>